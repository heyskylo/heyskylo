<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ABI revision of the manifest format the bootloader must understand. -->
	<key>NXRomManifestVersion</key>
	<integer>1</integer>

	<!-- Identity -->
	<key>NXRomIdentifier</key>
	<string>org.emexlabs.rom.minecraftdungeons</string>
	<key>NXRomName</key>
	<string>Minecraft Dungeons</string>
	<key>NXRomVersion</key>
	<string>1.0.0</string>
	<key>NXRomMinimumNyxianVersion</key>
	<string>0.11.5</string>

	<!-- The slot image loaded by the bootloader (dlopen, must expose NXSlotMain). -->
	<key>NXRomExecutable</key>
	<string>main</string>

	<!-- Defaults applied to every extracted file/directory that is not listed
	     in NXRomPaths below. 420 = 0644, 493 = 0755. -->
	<key>NXRomDefaultFilePermission</key>
	<integer>420</integer>
	<key>NXRomDefaultDirectoryPermission</key>
	<integer>493</integer>

	<!-- Explicit per-path setup. Mach-O payloads carry the exec bit and get
	     re-signed at flash time with the certificate imported in Nyxian
	     (required: iOS only loads validly-signed Mach-O). -->
	<key>NXRomPaths</key>
	<array>
		<dict>
			<key>NXPath</key>
			<string>main</string>
			<key>NXPermission</key>
			<integer>493</integer>
			<key>NXRequiresCodeSigning</key>
			<true/>
		</dict>
		<dict>
			<key>NXPath</key>
			<string>Application/Hello.app/Hello</string>
			<key>NXPermission</key>
			<integer>493</integer>
			<key>NXRequiresCodeSigning</key>
			<true/>
		</dict>
	</array>

	<!-- Optional hooks (not built by this ROM):
	     - NXRomInstaller / NXRomUninstaller: dylib paths exporting
	       NXRomInstall() / NXRomUninstall() run at flash/unflash.
	     - NXRomBootLogo: { Light, Dark } image paths relative to the slot,
	       shown by the bootloader splash. -->
</dict>
</plist>